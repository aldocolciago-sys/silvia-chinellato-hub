{
  "name": "silvia-chinellato-hub",
  "private": true,
  "version": "1.0.0",
  "description": "Sito pubblico e agenda riservata di Silvia Chinellato",
  "type": "module",
  "scripts": {
    "serve": "node tests/support/server.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:coverage && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@vitest/coverage-v8": "^3.2.7",
    "acorn": "^8.18.0",
    "fullcalendar": "^6.1.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^3.4.19",
    "vitest": "^3.2.7"
  }
}
